# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your real passwords never reach GitHub.
# Never put real passwords in THIS file (.env.example is committed).

# --- Core -------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste_a_long_random_string_here
MONGO_URI=mongodb://localhost:27017/lostfound
# 1 = development mode (auto-reload, detailed errors). Use 0 for the final demo/deployment.
FLASK_DEBUG=1

# --- Gmail SMTP (see SETUP_GUIDE.md, step 9) ---------------------------
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_16_letter_app_password
MAIL_SENDER_NAME=Campus Lost & Found

# --- Your college --------------------------------------------------------
COLLEGE_NAME=Your College Name
# Only these email domains can register (comma separated, no @).
ALLOWED_EMAIL_DOMAINS=yourcollege.edu.in
CONTACT_EMAIL=security@yourcollege.edu.in
CONTACT_PHONE=+91 00000 00000
SECURITY_DESK_LOCATION=Main Security Office, Ground Floor, Admin Block
SECURITY_DESK_HOURS=Mon-Sat, 9:00 AM - 5:00 PM
# Suggestions shown in the "location" box (comma separated).
CAMPUS_LOCATIONS=Library,Canteen,Main Gate,Parking Area,Auditorium,Sports Ground,Hostel,Computer Lab,Admin Block,Classroom Block
TIMEZONE=Asia/Kolkata

# --- Only when the site runs on HTTPS (deployment) ------------------------
# 1 = cookies are only sent over HTTPS. Keep 0 for http://127.0.0.1 on your laptop.
COOKIE_SECURE=0
# 1 = the app runs behind a reverse proxy (Nginx, Render, Railway...).
BEHIND_PROXY=0
